RAW_DATA_PATH=./data/raw_pdfs
EXTRACTED_DATA_PATH=./data/extracted_pdfs
ESSENTIALS_PATH=./essentials

CHROMA_PERSIST_PATH=./chroma_store
HIERARCHY_STORE_PATH=./essentials/summary_tree.json

OLLAMA_EMBEDDINGS_MODEL=nomic-embed-text
OLLAMA_SUMMARY_MODEL=llama3
OLLAMA_LLM_RESPONSE_MODEL=llama3

OLLAMA_LLM_RESPONSE_CONFIG={"model":"llama3","temperature":0.2,"top_p":0.9,"top_k":40,"repeat_penalty":1.1,"max_context_length":8000,"default_top_k_root":2,"default_top_k_children":3}

UMAP_N_NEIGHBORS=15
UMAP_N_COMPONENTS=2
CLUSTER_DIVISOR=5

MAX_RETRIEVED_CHUNKS=10